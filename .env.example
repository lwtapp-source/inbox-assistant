# --- Server ---
PORT=3000
BASE_URL=https://your-app.onrender.com

# --- Postgres (Render managed Postgres gives you this connection string) ---
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Anthropic (draft + classify calls) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Google OAuth (console.cloud.google.com > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# Must match a redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/auth/google/callback

# --- Microsoft OAuth (entra.microsoft.com / Azure Portal > App registrations) ---
MS_CLIENT_ID=...
MS_CLIENT_SECRET=...
# Must match a redirect URI registered on the app registration
MS_REDIRECT_URI=https://your-app.onrender.com/auth/outlook/callback

# --- Polling ---
# How often (minutes) each connected inbox is checked for new mail
POLL_INTERVAL_MINUTES=5

# Shared secret used to protect the /poll trigger endpoint (see render.yaml cron job)
POLL_TRIGGER_SECRET=change-me
